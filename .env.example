# Required — ODS v2.1 datasets base URL (no trailing slash) and dataset id.
# Example: https://<portal>/api/explore/v2.1/catalog/datasets
PORTAL_API_URL=
PORTAL_DATASET=

MAX_PAGES=10

# Default classifier: hybrid (regex hard rules + Mistral semantic judgement).
# Requires MISTRAL_API_KEY. Falls back to regex if the key is missing.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Override mode if needed: hybrid | llm | regex
# CLASSIFIER=hybrid

# --- Server / Clever Cloud deployment (not needed for the local CLI) -----

# PostgreSQL connection string. On Clever Cloud this is injected automatically
# when the PostgreSQL add-on is linked to the app.
# POSTGRESQL_ADDON_URI=postgresql://user:pass@host:5432/db

# Auth: users log in with a 6-digit code sent by email (no passwords).
# OTP_PEPPER secret hashes the codes at rest — required in production
# (generate with: openssl rand -base64 32).
# ADMIN_EMAILS: comma-separated emails upserted as admin at startup (grant-only).
# ALLOWED_EMAIL_DOMAINS: emails on these domains may log in without a
# pre-created account (user row created at first login, non-admin).
# OTP_PEPPER=
# ADMIN_EMAILS=hugo.venturini@gmail.com
# ALLOWED_EMAIL_DOMAINS=explainconsultancy.com

# Email via MailPace (login codes + daily digest + failure alerts).
# Token from the MailPace dashboard; EMAIL_FROM must be on the DKIM-verified
# domain. Without a token: digests are skipped and login codes are printed to
# stderr (local dev only — nobody can log in to a deployed app without email).
# The daily digest goes to users who opted in on their profile page
# (off by default).
# MAILPACE_API_TOKEN=
# EMAIL_FROM=avis@example.com
# ALERT_RECIPIENT=hugo.venturini@gmail.com

# Public URL of the dashboard, linked from the digest email. An https:// value
# also switches auth cookies to production mode (__Host- prefix, Secure).
# DASHBOARD_URL=https://<app>.cleverapps.io
