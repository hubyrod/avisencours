{
  "name": "avis-en-cours",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "scrape": "bun run src/index.ts",
    "run:daily": "bun run src/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "bun test",
    "build": "bun build src/server.ts src/run.ts src/index.ts --target=bun --outdir=dist"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.3"
  }
}
